{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beard-trim-map",
  "main": "./worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
