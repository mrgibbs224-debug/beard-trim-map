{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beard-trim-map-test",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
